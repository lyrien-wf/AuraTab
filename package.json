{
  "name": "auratab",
  "displayName": "AuraTab",
  "version": "1.1.0",
  "description": "把收藏夹变成你的浏览器主页（Chromium MV3 新标签页扩展）",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-version.mjs && tsc --noEmit && vite build && vite build -c vite.config.sw.ts",
    "build:fast": "node scripts/sync-version.mjs && vite build && vite build -c vite.config.sw.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^14.3.1",
    "@types/chrome": "^0.0.268",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^30.1.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
